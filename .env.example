VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional: keep the NVIDIA key server-side (never prefix it with VITE_).
# Without it, the assistant uses reviewed AirAware guidance in guide mode.
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Optional ground monitoring station feed (server-side only; never prefix with VITE_).
# Obtain an OpenAQ v3 key from https://explore.openaq.org/register
OPENAQ_API_KEY=
